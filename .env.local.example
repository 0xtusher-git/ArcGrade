# RepDex / ArcGrade environment variables
#
# Copy this file to .env.local and fill in the values you need.
#
# Security:
# - Never commit .env.local, real API keys, private keys or funded addresses.
# - Every variable prefixed with NEXT_PUBLIC_ is inlined into the browser bundle
#   at build time and is therefore public. Never put secrets in a NEXT_PUBLIC_
#   variable.
# - Only DEPLOYER_PRIVATE_KEY and CLAUDE_API_KEY are secrets. They are read by
#   server-side code and deploy scripts and are never exposed to the browser.
#
# Variables left empty fall back to the defaults in the code, where one exists.
# See README.md for the full table of variables, consumers and networks.

# ---------------------------------------------------------------------------
# SHARED
# Used by more than one area: the Arc mainnet RPC is read by the ArcGrade API
# and contract helpers, by Hardhat, and by the standalone deploy script.
# ---------------------------------------------------------------------------

# Arc mainnet RPC endpoint. Read by the ArcGrade API/contract helpers, Hardhat
# and scripts/deploy-standalone.js. Public.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io

# Deployer wallet private key, read only by hardhat.config.cjs and
# scripts/deploy-standalone.js. SECRET - keep it out of version control and
# never prefix it with NEXT_PUBLIC_.
DEPLOYER_PRIVATE_KEY=

# WalletConnect Cloud project ID. Read by lib/appWagmi.ts (RepDex, Arc Testnet).
# When empty the WalletConnect option is omitted from the connect modal and the
# rest of the app keeps working. Public.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# ARCGRADE + TERMINAL
# Arc mainnet. Used by the Terminal page (/), ArcGrade pages (/arcgrade,
# /leaderboard, /my-score, /score/[address], /challenge, /deploy, /api-docs)
# and the /api routes that back them.
# ---------------------------------------------------------------------------

# Anthropic API key used by /api/analyze and /api/v1/analyze to write the
# reputation verdict. SECRET. Optional: without it those routes fail at the
# Claude call, the score itself is still computed locally.
CLAUDE_API_KEY=sk-ant-your-key-here

# ArcTrust (ArcGrade) reputation contract on Arc mainnet. Read by
# lib/contract.ts. Public.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xF98468E92dcE3e2653c200e44Cc2506a7839437A

# Arc mainnet chain ID. Read by lib/contract.ts and hooks/useWallet.tsx.
# Public.
NEXT_PUBLIC_CHAIN_ID=5042

# Arc mainnet block explorer base URL. Re-exported through next.config.js.
# Public.
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io

# ---------------------------------------------------------------------------
# REPDEX
# Arc Testnet. Used only by the /swap, /bridge and /liquidity app routes.
# ---------------------------------------------------------------------------

# Arc Testnet RPC endpoint. Read by lib/dexConfig.testnet.ts. Public.
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Arc Testnet block explorer base URL. Read by lib/dexConfig.testnet.ts. Public.
NEXT_PUBLIC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app

# Uniswap v4 contracts on Arc Testnet. Deploy them yourself and paste the
# addresses here; the swap action stays disabled until all four are set and a
# pool is configured in lib/dexConfig.testnet.ts. Read by
# lib/dexConfig.testnet.ts. Public.
NEXT_PUBLIC_UNIV4_POOL_MANAGER=
NEXT_PUBLIC_UNIV4_POSITION_MANAGER=
NEXT_PUBLIC_UNIV4_UNIVERSAL_ROUTER=
NEXT_PUBLIC_UNIV4_QUOTER=

# Permit2 address on Arc Testnet. lib/dexConfig.testnet.ts reads
# NEXT_PUBLIC_UNIV4_PERMIT2 first and falls back to NEXT_PUBLIC_PERMIT2, then to
# the canonical Permit2 address below. Set only one of the two. Public.
NEXT_PUBLIC_UNIV4_PERMIT2=
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Optional cirBTC / WETH overrides on Arc Testnet. USDC and EURC are built in
# and cannot be overridden. The app defaults to the official Arc Testnet
# addresses published at https://docs.arc.io/arc/references/contract-addresses
# (retrieved 2026-11-01). Set either value only to point at a different
# deployment; decimals() is read from the contract at runtime. A malformed or
# empty value falls back to the official address. Read by
# lib/dexConfig.testnet.ts. Public.
NEXT_PUBLIC_TOKEN_CIRBTC=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
NEXT_PUBLIC_TOKEN_WETH=0x2c4047028a72803939b6fb674D01bC059B5C4961
