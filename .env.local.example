# ─────────────────────────────────────────────
# ArcTrust Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to GitHub!
# ─────────────────────────────────────────────

# Claude AI API Key (get from console.anthropic.com)
CLAUDE_API_KEY=sk-ant-your-key-here

# Arc Testnet Smart Contract Address (fill in after deploying ArcTrust.sol)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourContractAddressHere

# Arc Testnet RPC
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Arc Testnet Chain ID (official: 5042002)
NEXT_PUBLIC_CHAIN_ID=5042002

# Arc Testnet Explorer
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app
