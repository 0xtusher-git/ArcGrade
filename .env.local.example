# ArcTrust / RepDex environment variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to GitHub.

# Claude AI API key (optional - used by the reputation analysis endpoint)
CLAUDE_API_KEY=sk-ant-your-key-here

# ArcGrade reputation contract address on Arc mainnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0xF98468E92dcE3e2653c200e44Cc2506a7839437A

# Arc mainnet public RPC (free)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io

# Arc mainnet chain ID
NEXT_PUBLIC_CHAIN_ID=5042

# Arc mainnet explorer
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io
