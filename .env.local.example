# ─────────────────────────────────────────────
# ArcTrust Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to GitHub!
# ─────────────────────────────────────────────

# Claude AI API Key (get from console.anthropic.com)
CLAUDE_API_KEY=sk-ant-your-key-here

# Arc Mainnet Smart Contract Address (fill in after deploying ArcTrust.sol)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourContractAddressHere

# Arc Mainnet RPC
NEXT_PUBLIC_RPC_URL=https://api.mainnet.abs.xyz

# Arc Mainnet Chain ID (official: 2741)
NEXT_PUBLIC_CHAIN_ID=2741

# Arc Mainnet Explorer
NEXT_PUBLIC_EXPLORER_URL=https://abscan.org
