# ArcTrust / RepDex environment variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to GitHub.

# Claude AI API key (optional - used by the reputation analysis endpoint)
CLAUDE_API_KEY=sk-ant-your-key-here

# ArcGrade reputation contract address on Arc mainnet (used by Terminal/ArcGrade pages)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xF98468E92dcE3e2653c200e44Cc2506a7839437A

# Arc mainnet public RPC (free) - used by Terminal/ArcGrade pages
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io

# Arc mainnet chain ID - used by Terminal/ArcGrade pages
NEXT_PUBLIC_CHAIN_ID=5042

# Arc mainnet explorer - used by Terminal/ArcGrade pages
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io

# --- Arc Testnet (used only by the /swap, /bridge and /liquidity app routes) ---
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app

# WalletConnect Project ID (required for WalletConnect option)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Uniswap v4 contracts on Arc Testnet (deploy yourself - do not guess)
NEXT_PUBLIC_UNIV4_POOL_MANAGER=
NEXT_PUBLIC_UNIV4_POSITION_MANAGER=
NEXT_PUBLIC_UNIV4_UNIVERSAL_ROUTER=
NEXT_PUBLIC_UNIV4_QUOTER=
# Permit2 (deployed at the canonical address on most chains; override if different)
NEXT_PUBLIC_UNIV4_PERMIT2=
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Testnet tokens (optional overrides)
NEXT_PUBLIC_TESTNET_USDC=
NEXT_PUBLIC_TESTNET_WETH=
NEXT_PUBLIC_TESTNET_EURC=
